# ---------------------------------------------------------------------------
# FakeStore API automation - environment configuration
#
# Copy to `.env` and adjust. Every value below has a safe default in
# src/config/environments.ts, so the suite runs with no .env file at all.
# Real secrets must never be committed - `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Which environment definition to load: local | staging | production
TEST_ENV=production

# Overrides the base URL of the selected environment.
# BASE_URL=https://fakestoreapi.com

# --- Timing -----------------------------------------------------------------
# Hard timeout for a single HTTP request (ms).
REQUEST_TIMEOUT_MS=30000
# Budget a single test may take (ms).
TEST_TIMEOUT_MS=60000
# Threshold for `expect(response).toRespondWithin()` (ms).
#
# This is a guard against PATHOLOGICAL slowness (an endpoint going from 350ms
# to 30s), not a latency benchmark. Measured under this suite's 4-worker
# concurrency: p50 324ms / p95 355ms / p99 797ms / max 847ms - but the sandbox
# sits behind a CDN and has occasional slow spells, one of which was observed
# to make a whole run 2.5x slower. A tight budget would make functional results
# depend on network weather. Fine-grained latency belongs in a dedicated
# performance suite - see the extension plan in the README.
RESPONSE_SLA_MS=10000

# --- Resilience -------------------------------------------------------------
# Transport-level retries for network errors / 5xx / 429 responses.
HTTP_RETRIES=2
HTTP_RETRY_BACKOFF_MS=400

# --- Credentials ------------------------------------------------------------
# Published demo credentials from https://fakestoreapi.com/docs.
# In a real project these come from the CI secret store, never from git.
AUTH_USERNAME=mor_2314
AUTH_PASSWORD=83r5^_

# --- Logging ----------------------------------------------------------------
# silent | error | warn | info | debug
LOG_LEVEL=info
# Attach the full request/response log to every test, not just failures.
ATTACH_ALL_LOGS=false

# --- Contract testing -------------------------------------------------------
# Rewrite contract snapshots instead of asserting against them.
UPDATE_CONTRACTS=false
# Treat additive (backwards-compatible) changes as failures too.
CONTRACT_STRICT=false
